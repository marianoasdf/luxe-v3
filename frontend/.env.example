# ============================================================
# luxe-v3 — Frontend (.env.example)
# ============================================================

# URL base del backend (sin /api — se agrega en lib/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mercado Pago — clave pública
# NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile — site key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...

# Cloudinary — cloud name (para previsualización de imágenes)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
