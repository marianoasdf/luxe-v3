# ============================================================
# luxe-v3 — Backend (.env.example)
# ============================================================

# ---- Entorno ----
NODE_ENV=development
PORT=4000

# ---- PostgreSQL ----
# Opción A (local): completar las variables PG*
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=luxe_db

# Opción B (Render / Neon / Heroku): usar una sola URL
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- JWT y sesiones ----
JWT_SECRET=change_this_secret
ACCESS_EXPIRES=15m
REFRESH_EXPIRES_DAYS=30

# ---- Redis (opcional) ----
# URL de conexión. Si se omite, el código usa fallback en memoria.
# REDIS_URL=redis://localhost:6379
# Ejemplo Upstash (copiar "Redis URL"):
# REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:port

# ---- CORS ----
# Next.js corre por defecto en :3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- URLs base ----
API_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000

# ---- Acceso admin ----
# Permite usar header X-Admin-Secret en endpoints admin
# ADMIN_SECRET=cambiame

# ---- Mercado Pago ----
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudinary (uploads firmados) ----
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret
# CLOUDINARY_UPLOAD_PRESET=ml_default

# Límites de imágenes
# MAX_PRODUCT_IMAGES=8
# MAX_IMAGE_MB=5

# ---- Turnstile (Cloudflare CAPTCHA) ----
# TURNSTILE_SECRET_KEY=0x4AAAA...

# ---- Email — Resend (verificación) ----
# Activar envío real (true|false). Si es false, solo loguea el enlace.
EMAIL_SEND_REAL=false
# RESEND_API_KEY=your_resend_key
RESEND_FROM=No Reply <no-reply@tu-dominio.com>
# URL del frontend para construir enlaces de verificación (Next.js → :3000)
VERIFICATION_BASE_URL=http://localhost:3000

# ---- ENVÍOS — Correo Argentino ----
# Modo: 'fixed' (tabla local de costos) o 'api' (PAQ.AR API v2)
SHIPPING_MODE=fixed

# URL base PAQ.AR (requerido si SHIPPING_MODE=api)
# Producción: https://api.correoargentino.com.ar/paqar/v1
# Testing:    https://apitest.correoargentino.com.ar/paqar/v1
# CA_API_BASE_URL=https://api.correoargentino.com.ar/paqar/v1

# Autenticación PAQ.AR
# CA_API_KEY=tu_api_key
# CA_AGREEMENT=18017

# Opcional: seller interno
# CA_SELLER_ID=mi_seller

# Opcional: formato de rótulo en /v1/labels (10x15 | label)
# CA_LABEL_FORMAT=10x15

# Opcional: timeouts y metadata de orden
# CA_API_TIMEOUT_MS=12000
# CA_SERVICE_TYPE=CP
# CA_PRODUCT_CATEGORY=general

# Datos del remitente para /v1/orders
# CA_SENDER_ID=18017
# CA_SENDER_BUSINESS_NAME=Luxe
# CA_SENDER_EMAIL=ventas@luxeargentina.com
# CA_SENDER_PHONE=1140000000
# CA_SENDER_STREET_NAME=Av Siempre Viva
# CA_SENDER_STREET_NUMBER=742
# CA_SENDER_CITY=CABA
# CA_SENDER_STATE=C
# CA_SENDER_ZIP_CODE=1000

# Fallback a tabla fija si API falla (true|false, default: true)
# SHIPPING_API_FALLBACK=true

############################################################
# Fin .env.example
############################################################
